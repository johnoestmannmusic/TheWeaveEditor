<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TheWeave.Core\TheWeave.Core.csproj" />
    <ProjectReference Include="..\TheWeave.Importer\TheWeave.Importer.csproj" />
    <ProjectReference Include="..\TheWeave.Exporter\TheWeave.Exporter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared with the exported site, so that a puzzle looks the same in both. -->
    <Content Include="..\TheWeave.Exporter\runtime\puzzleRules.js" Link="wwwroot\puzzleRules.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TheWeave.Exporter\runtime\puzzleColours.js" Link="wwwroot\puzzleColours.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TheWeave.Exporter\runtime\puzzleDrawing.js" Link="wwwroot\puzzleDrawing.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TheWeave.Exporter\runtime\puzzle.js" Link="wwwroot\puzzle.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TheWeave.Exporter\runtime\sokoban.js" Link="wwwroot\sokoban.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TheWeave.Exporter\runtime\board.js" Link="wwwroot\board.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheWeave.EditorApp.Tests" />
  </ItemGroup>

</Project>
